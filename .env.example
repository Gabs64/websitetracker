# Google Sheets Backend Configuration
# Copy this file to .env and fill in the Web App URL from your Google Sheet's Apps Script deployment.

GOOGLE_SHEETS_WEBAPP_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Optional: Explicitly restrict frontend login to this single owner email address
OWNER_EMAIL=owner@example.com

# Groq AI API Key for AI Website Price Auto-Detection & Valuation Breakdown
# Get a free API key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
